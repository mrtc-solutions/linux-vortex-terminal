# Vortex Terminal — AI Provider Credentials & Configuration
#
# Copy this file to `.env` (in repository root) or `~/.config/vortex/.env`
# and fill in only the providers you use.
#
# WEB / VERCEL DEPLOYMENT: set these SAME variable names in the Vercel
# project's Environment Variables (server-side only). Never create
# NEXT_PUBLIC_*/VITE_* equivalents — keys must never reach the browser.
#
# SECURITY & PRIVACY INVARIANTS:
# 1. `.env` is gitignored: NEVER commit real keys, paste them into git, or share in logs.
# 2. Values are NEVER logged or transmitted to renderer/UI (UI only sees configured: true|false).
# 3. Before context is sent to cloud models, secrets, tokens, passwords, and private keys are redacted.
# 4. Zero keys required: Local Ollama (qwen2.5:3b) runs 100% offline at $0 forever.
#
# Free AI Catalogue Reference:
# https://github.com/open-free-llm-api/awesome-freellm-apis (https://freellm.net/)

# ============================================================================
# 1. PRIMARY LOCAL AI (Default - Zero API Keys Needed)
# ============================================================================
# Local loopback Ollama endpoint and primary model:
# OLLAMA_ENDPOINT=http://127.0.0.1:11434
# LOCAL_PRIMARY_MODEL=qwen2.5:3b

# ============================================================================
# 2. GOOGLE GEMINI (3 Logical Model Entries)
# ============================================================================
# Free tier from Google AI Studio (covers Flash / Flash-Lite models).
# Two keys can serve all three logical entries (e.g. Gemini #1 and #3 share slot 1).
# Official API Key: https://aistudio.google.com/apikey
GEMINI_API_KEY_1=
GEMINI_API_KEY_2=
GEMINI_API_KEY_3=

# ============================================================================
# 3. CLOUD AI PROVIDERS (OpenAI-Compatible & Dedicated APIs)
# ============================================================================

# Groq (Ultra-fast LPU inference, 30 RPM / 14,400 RPD free tier, no credit card)
# Official Key: https://console.groq.com/keys
GROQ_API_KEY=

# OpenRouter (Aggregator with dynamic :free models, e.g. 20 RPM / 50 RPD)
# Official Key: https://openrouter.ai/keys
OPENROUTER_API_KEY=

# NVIDIA NIM (40 RPM free tier on Llama/Qwen/DeepSeek, requires phone verification)
# Official Key: https://build.nvidia.com
NVIDIA_NIM_API_KEY=

# ModelScope (Alibaba ModelScope free inference, ~2,000 calls/day)
# Official Key: https://modelscope.cn/my/myaccesstoken
MODELSCOPE_API_KEY=

# Cloudflare Workers AI (10,000 neurons/day free allocation)
# Official Key: https://dash.cloudflare.com/profile/api-tokens
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=

# OpenCode Zen (Free coding assistant models)
# Official Key: https://opencode.ai/auth
OPENCODE_API_KEY=

# LLM7.io (10-30 RPM free tier including GPT-4o-mini & DeepSeek-R1)
# Official Key: https://llm7.io
LLM7_API_KEY=

# Ollama Cloud (Hosted cloud Ollama models with free quota)
# Official Key: https://ollama.com
OLLAMA_CLOUD_API_KEY=

# Mistral AI (La Plateforme experiment free tier)
# Official Key: https://console.mistral.ai/api-keys
MISTRAL_API_KEY=

# Kilo Code (Coding API gateway with 200 req/hr free tier)
# Official Key: https://kilo.ai
KILO_API_KEY=

# OVHcloud AI Endpoints (European AI endpoints, anonymous/free tier)
# Official Key: https://endpoints.ai.cloud.ovh.net
OVHCLOUD_API_KEY=

# Cohere (Trial API keys: 1,000 free calls/month)
# Official Key: https://dashboard.cohere.com/api-keys
COHERE_API_KEY=

# Aion Labs (Proprietary Aion models: 15 RPM / 20K tokens/day free)
# Official Key: https://aionlabs.ai
AION_API_KEY=

# Hugging Face (Inference Router: ~1,000 req/day free on shared GPUs)
# Official Key: https://huggingface.co/settings/tokens
HUGGINGFACE_API_KEY=

# Z AI / Zhipu AI (GLM-4 Flash series free tier)
# Official Key: https://open.bigmodel.cn/usercenter/apikeys
ZAI_API_KEY=

# Cerebras (Wafer-scale inference: 30 RPM, 14,400 RPD, ~1M tokens/day)
# Official Key: https://cloud.cerebras.ai
CEREBRAS_API_KEY=

# Agnes AI (Sapiens Singapore: 30 RPM free tier)
# Official Key: https://agnes-ai.com
AGNES_API_KEY=

# Alibaba Cloud Model Studio (DashScope free trial token quota)
# Official Key: https://dashscope.console.aliyun.com
ALIBABA_API_KEY=

# SambaNova (Fast SN40L inference developer free tier)
# Official Key: https://cloud.sambanova.ai/apis
SAMBANOVA_API_KEY=

# SiliconFlow (Free badges on selected open models)
# Official Key: https://cloud.siliconflow.cn/account/ak
SILICONFLOW_API_KEY=

# xAI / Grok ($25/month recurring monthly free credits)
# Official Key: https://console.x.ai
XAI_API_KEY=

# Chutes.ai (Community-donated compute at $0)
# Official Key: https://chutes.ai
CHUTES_API_KEY=

# Glhf.chat (Unlimited rate on free community models)
# Official Key: https://glhf.chat
GLHF_API_KEY=

# AI21 Labs (Jamba models free tier with 256K context)
# Official Key: https://studio.ai21.com/account/api-key
AI21_API_KEY=

# DeepSeek (Direct platform API for DeepSeek-V3 and DeepSeek-R1)
# Official Key: https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=

# Nscale (European GPU compute fair-use free tier)
# Official Key: https://console.nscale.com
NSCALE_API_KEY=

# Nebius (AI Studio EU trial credit)
# Official Key: https://studio.nebius.com
NEBIUS_API_KEY=

# Cline (Rotating promotional free models)
# Official Key: https://cline.bot
CLINE_API_KEY=

# Scaleway (Generative APIs)
# Official Key: https://console.scaleway.com
SCALEWAY_API_KEY=

# Tencent Cloud Hunyuan (hunyuan-lite free model)
# Official Key: https://cloud.tencent.com/product/hunyuan
TENCENT_API_KEY=

# Arli AI (Rate-limited developer tier)
# Official Key: https://arliai.com
ARLI_API_KEY=

# Pollinations (Community keyless API - no key needed)
POLLINATIONS_API_KEY=

# ============================================================================
# 4. POLICY & PRIVACY CONTROLS
# ============================================================================
# Strict Free-Only Mode ($0 cost guarantee; blocks paid models & trial overages)
FREE_ONLY_MODE=true

# Privacy mode: "hybrid" (allows cloud after secret redaction) or "local_only"
# PRIVACY_MODE=hybrid
