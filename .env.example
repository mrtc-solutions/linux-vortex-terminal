# Vortex Terminal — AI provider credentials
#
# Copy this file to `.env` (repository root) or to
# `~/.config/vortex/.env` and fill in only the providers you actually use.
# `.env` is gitignored: NEVER commit real keys, never paste them into
# source code, and never share them in logs or screenshots.
#
# Only keys for providers you enable are required. Everything works with
# no keys at all when local Ollama (qwen2.5:3b) is available.

# --- Google Gemini ----------------------------------------------------------
# Two keys can serve all three Gemini model entries (Gemini #3 reuses
# slot 1 or 2 — configurable in the AI Providers panel).
GEMINI_API_KEY_1=
GEMINI_API_KEY_2=
GEMINI_API_KEY_3=

# --- Other cloud providers --------------------------------------------------
GROQ_API_KEY=
OPENROUTER_API_KEY=

# Cloudflare Workers AI needs both an API token and the account id.
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=

ZAI_API_KEY=
SILICONFLOW_API_KEY=
MISTRAL_API_KEY=
COHERE_API_KEY=
SAMBANOVA_API_KEY=
SCALEWAY_API_KEY=
ALIBABA_API_KEY=
TENCENT_API_KEY=
MODELSCOPE_API_KEY=
OLLAMA_CLOUD_API_KEY=
ARLI_API_KEY=
# Pollinations requires no key.
POLLINATIONS_API_KEY=

# --- Policy -----------------------------------------------------------------
# Optional override; free-only mode already defaults to ON in settings.
# FREE_ONLY_MODE=true
